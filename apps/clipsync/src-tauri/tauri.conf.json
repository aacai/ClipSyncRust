{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipSync",
  "version": "0.0.10",
  "identifier": "com.zhiqiu.clipsync",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1440",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipSync",
        "width": 960,
        "height": 640,
        "minWidth": 680,
        "minHeight": 460,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/app.icns", "icons/icon.ico"],
    "targets": "all"
  }
}
